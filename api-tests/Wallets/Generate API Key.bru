meta {
  name: Generate API Key
  type: http
  seq: 7
}

post {
  url: {{base_url}}/v1/wallets/{{wallet_id}}/api-key
  body: json
  auth: none
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "confirm": true
  }
}

script:post-response {
  if (res.body?.data?.api_key) {
    bru.setVar("api_key", res.body.data.api_key);
  }
}

docs {
  Generates this wallet's API key. Shown once — save it. The first key needs no body; once a key
  exists, rotating it (which immediately invalidates the previous one) requires "confirm": true,
  otherwise the call returns 409. Sent here with confirm so the request is re-runnable.
  Auto-saved to api_key, which is what an integrating merchant's backend would use instead of a
  dashboard JWT for server-to-server calls (e.g. creating payment links).
}
